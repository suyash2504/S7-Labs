# Contact form delivery.
#
# Nothing here needs setting. Enquiries go to Web3Forms, which emails them to
# the studio inbox; the endpoint and access key have defaults in
# src/lib/enquiry.js, where the reasoning is written down.
#
# Set these only to send somewhere else instead:
#
#   Formspree   https://formspree.io/f/xxxxxxxx      (no access key)
#   Basin       https://usebasin.com/f/xxxxxxxx      (no access key)
#   Your own    any endpoint accepting a JSON POST
#
# Dev builds never deliver: submissions validate, log to the console, and the
# UI says plainly that nothing was sent. Use `npm run build && npm run preview`
# to exercise the real path.

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Public origin, e.g. https://s7labs.in (no trailing slash).
# Leave empty until the real domain exists: canonical, og:url, og:image and
# sitemap.xml are then omitted rather than pointing at a domain you do not own.
VITE_SITE_URL=
