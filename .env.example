# Contact form delivery.
#
# By default nothing here needs setting: production builds submit to Netlify
# Forms, which is declared statically in index.html and needs no keys. Enquiries
# appear under Forms in the Netlify dashboard; turn on email notifications there
# to have them forwarded.
#
# Set VITE_FORM_ENDPOINT only to send somewhere else instead:
#
#   Formspree   https://formspree.io/f/xxxxxxxx      (no access key)
#   Basin       https://usebasin.com/f/xxxxxxxx      (no access key)
#   Web3Forms   https://api.web3forms.com/submit     (access key required)
#   Your own    any endpoint accepting a JSON POST
#
# Dev builds never deliver: submissions validate, log to the console, and the
# UI says plainly that nothing was sent.

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# Public origin, e.g. https://s7labs.in (no trailing slash).
# Leave empty until the real domain exists: canonical, og:url, og:image and
# sitemap.xml are then omitted rather than pointing at a domain you do not own.
VITE_SITE_URL=
