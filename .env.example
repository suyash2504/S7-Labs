# Copy to `.env` and fill in to make the contact form deliver for real.
# Until VITE_FORM_ENDPOINT is set, submissions validate and log to the console,
# and the UI says the enquiry was captured but not delivered.
#
#   Formspree   https://formspree.io/f/xxxxxxxx      (no access key)
#   Basin       https://usebasin.com/f/xxxxxxxx      (no access key)
#   Web3Forms   https://api.web3forms.com/submit     (access key required)
#   Your own    any endpoint accepting a JSON POST

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
